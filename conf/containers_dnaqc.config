/*
 * containers_dnaqc.config — OPTIONAL explicit image map for basej-dnaqc.
 *
 * Not needed when the GHCR mirror is in place (sherlock.config's singularity.registry handles
 * every basejumper_* name). Use this instead if you would rather pull the images BioSkryb still
 * hosts on their public ECR directly and take only the four rebuilt ones from GHCR:
 *
 *   nextflow run ... -c conf/sherlock.config -c conf/containers_dnaqc.config
 */
def ECR  = 'public.ecr.aws/v2u5x5f1/basejumper'
def GHCR = 'ghcr.io/gawad-lab-stanford'

process {
    withName: 'MERGE_MULTILANE_FASTQ'   { container = "${ECR}:ubuntu_24.04_stable" }
    withName: 'SEQKIT_SAMPLE'           { container = "${ECR}:seqkit-2.13.0" }
    withName: 'SAMTOOLS_SUBSAMPLE_CRAM' { container = "${GHCR}/basejumper_samtools-1.23.1" }
    withName: 'SAMTOOLS_MARKDUP'        { container = "${GHCR}/basejumper_samtools-1.23.1" }
    withName: 'BWAMEM2_ALIGN'           { container = "${GHCR}/basejumper_bwamem2_samtools_2.2.1" }
    withName: 'PICARD_METRICS'          { container = "${ECR}:picard_addorreplacegroups_3.1.2" }
    withName: 'PRESEQ'                  { container = "${ECR}:preseq_bam2mr_0.1" }
    withName: 'GINKGO_BINUNSORT|GINKGO_SEGMENTATION_R|GINKGO_CNV_CALLER|GINKO_RDS_TO_FLAT|PARSE_RDS_CNV_METRICS' {
        container = "${GHCR}/basejumper_ginkgo_0.3.1"
    }
    withName: 'GINKO_PARSE_OUTPUTS'     { container = "${ECR}:ginko_parser_0.2.1" }
    withName: 'GINKGO_BINS_TO_PARQUET'  { container = "${ECR}:custom_parabricks-metrics_1.0.3" }
    withName: 'QC_PLOTS'                { container = "${GHCR}/basejumper_custom_r_qcplots_0.3.0" }
}
