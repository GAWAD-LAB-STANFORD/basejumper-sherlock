/*
 * sherlock.config — Gawad Lab layer for BioSkryb basej-public-pipelines on Stanford Sherlock
 *
 * Passed with `-c` AFTER the pipeline's own nextflow.config (see bin/run_bj.sh), so every
 * setting here overrides the upstream defaults.
 *
 * cgawad partition: 4 nodes x 24 CPU x 384 GB RAM, 7-day max walltime, NO GPUs.
 * Practical per-process ceiling used here: 20 CPU / 350 GB / 72 h (leaves node headroom).
 */

params {
    // Sherlock is x86; the upstream default is "arm" (Graviton) and selects the wrong images.
    architecture  = "x86"
    // Open-source tool path (BWA-MEM2 / samtools markdup / Picard) — no Sentieon license needed.
    pipeline_tool = "opensource"
    // Local reference bundle. Must hold the genomes/... layout from conf/genomes.config; the
    // open-source path additionally needs .../GATK_bundle/Sequence_bwamem2/ (bin/build_bwamem2_index.sbatch).
    genomes_base  = "/oak/stanford/groups/cgawad/Scripts/Basejumper/genomic_references"
    // Read length selects the Ginkgo CNV reference (GRCH38_RL_<len>_Bin<size>). Upstream now
    // defaults to 50; the lab's Illumina runs are 150 bp. Override per run with --read_length.
    read_length   = 150
    // Ceilings (the upstream defaults are 64 CPU / 256 GB / 48 h).
    max_cpus      = 20
    max_memory    = 350.GB
    max_time      = 72.h
}

process {
    executor = 'slurm'
    queue    = 'cgawad'

    // environment.config evaluates params.max_* when it is loaded, so the params above do not
    // shrink the upstream caps on their own — set the limits explicitly.
    resourceLimits = [ cpus: 20, memory: 350.GB, time: 72.h ]
    maxForks       = 50

    // Retry twice (covers OOM/timeout/preemption), then FAIL the run at the end instead of the
    // upstream default 'ignore', which silently drops a failed sample from the report.
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2

    // Optional: node-local NVMe for task scratch (faster than OAK/Lustre for many small files).
    // scratch = '$L_SCRATCH'
}

executor {
    name              = 'slurm'
    queueSize         = 50
    submitRateLimit   = '10/1min'
    pollInterval      = '30 sec'
    queueStatInterval = '2 min'
}

singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = '/oak/stanford/groups/cgawad/singularity_cache'
    pullTimeout = '4h'
    runOptions  = '-B /oak/stanford/groups/cgawad -B /scratch'
    // The upstream configs name their custom images without a registry (basejumper_<tag>).
    // Nextflow prefixes such names with this registry, so they resolve to the lab's GHCR mirror
    // (built/pulled by .github/workflows/mirror-images.yml). quay.io/... names are untouched.
    registry    = 'ghcr.io/gawad-lab-stanford'
}
docker.enabled = false

env {
    // Force the AVX2 bwa-mem2 build. The auto-dispatcher may pick the AVX-512 binary on
    // heterogeneous nodes and die with "illegal instruction" (upstream CI sets the same).
    BWAMEM2_BIN = 'bwa-mem2.avx2'
}
