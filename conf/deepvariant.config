/*
 * deepvariant.config — extra layer for basej-google-deepvariant on the GPU-less cgawad partition.
 *
 * Upstream runs call_variants on google/deepvariant:<ver>-gpu with `--gpus all`. Neither works
 * here, so all three DeepVariant stages use the CPU image (the same switch upstream's own
 * `test_cpu` profile makes). Written with an explicit docker.io prefix because
 * sherlock.config sets singularity.registry, which would otherwise be prepended to
 * "google/deepvariant".
 */
process {
    withName: 'DEEPVARIANT_.*' {
        container        = "docker.io/google/deepvariant:${params.deepvariant_version}"
        containerOptions = null
        accelerator      = null
    }
    // CPU call_variants is the slow step: give it the node.
    withName: 'DEEPVARIANT_CALL_VARIANTS.*' {
        cpus   = 20
        memory = 120.GB
        time   = 48.h
    }
}
